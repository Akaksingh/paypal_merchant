# PayPal sandbox credentials: developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App.
# Copy this file to .env (git-ignored) and fill it in. With no client id/secret the gateway runs the
# offline mock, which has the same interface and the same state machine.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) | live. Live is never selected unless you set it explicitly.
PAYPAL_ENV=sandbox
# Developer Dashboard -> your app -> Webhooks: add https://<public-url>/v1/paypal/webhook and paste its id.
# Subscribe to: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED,
# PAYMENT.CAPTURE.REVERSED, CUSTOMER.DISPUTE.CREATED, CUSTOMER.DISPUTE.UPDATED, CUSTOMER.DISPUTE.RESOLVED.
PAYPAL_WEBHOOK_ID=
# Force the offline mock even when credentials are present.
# PAYPAL_MODE=mock
# Currency PayPal charges in. USD (default) converts the Rs.49 deposit at PAYPAL_INR_PER_USD. INR charges it as
# Rs.49.00 but needs a sandbox business account that accepts INR (an India sandbox account did not: CURRENCY_NOT_SUPPORTED).
PAYPAL_CURRENCY=USD
# INR per 1 USD used to convert the deposit and prepaid baskets when PAYPAL_CURRENCY=USD.
PAYPAL_INR_PER_USD=85.0
# Where buyers are sent back after approving, and the link put in dispute evidence. Must be reachable by PayPal/buyers.
CHAKRA_PUBLIC_URL=http://127.0.0.1:8080
